digraph triggers {
  bgcolor="white"; rankdir=LR; pad=0.35; nodesep=0.5; ranksep=0.7;
  fontname="Helvetica"; splines=spline;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        penwidth=1.5, margin="0.20,0.13", color="#2F5FDF",
        fillcolor="#EAF1FC", fontcolor="#16233B"];
  edge [color="#6B7480", penwidth=1.4, arrowsize=0.85, fontname="Helvetica",
        fontsize=9, fontcolor="#55606E"];
  

  e1 [label=<<B>inbound email</B>>, fillcolor="#F0F2F5", color="#7A828E"];
  ses [label=<<B>SES</B>>, fillcolor="#EAF1FC", color="#2F5FDF"];
  e2 [label=<<B>portal upload</B>>, fillcolor="#F0F2F5", color="#7A828E"];
  api [label=<<B>API Gateway</B>>, fillcolor="#EAF1FC", color="#2F5FDF"];
  val [label=<<B>Lambda validate + assemble</B>>, fillcolor="#EAF1FC", color="#2F5FDF"];
  e3 [label=<<B>reviewer re-run</B>>, fillcolor="#F0F2F5", color="#7A828E"];
  e4 [label=<<B>nightly batch</B>>, fillcolor="#F0F2F5", color="#7A828E"];
  sfn [label=<<B>Step Functions</B><BR/><FONT POINT-SIZE="9">fan-out over open claims</FONT>>, fillcolor="#EAF1FC", color="#2F5FDF"];
  s3 [label=<<B>S3 raw prefix</B><BR/><FONT POINT-SIZE="9">claims/{claim_id}/</FONT>>, fillcolor="#EDEFF3", color="#5B6472", shape=cylinder, style="filled"];
  eb [label=<<B>EventBridge rule</B><BR/><FONT POINT-SIZE="9">folder-complete</FONT>>, fillcolor="#EAF1FC", color="#2F5FDF"];
  q [label=<<B>SQS claim-work</B>>, fillcolor="#EAF1FC", color="#2F5FDF"];
  w [label=<<B>worker pool</B>>, fillcolor="#E7F6EC", color="#1E9E57"];
  e1 -> ses;
  ses -> s3;
  e2 -> api;
  api -> val;
  val -> s3;
  e3 -> api;
  e4 -> sfn;
  sfn -> q;
  s3 -> eb;
  eb -> q;
  q -> w;
}
